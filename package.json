{
  "name": "pse-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:seed": "tsx scripts/validate-seed.ts",
    "benchmark:reports": "node --conditions=react-server --import tsx scripts/benchmark-reports.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed:meetings": "tsx scripts/seed-meetings.ts",
    "seed:activities": "tsx scripts/seed-activities.ts",
    "seed:finance": "tsx scripts/seed-finance.ts",
    "seed:accounts": "tsx scripts/seed-accounts.ts",
    "seed:team": "tsx scripts/seed-team.ts",
    "db:types": "tsx scripts/generate-database-types.ts",
    "db:types:check": "tsx scripts/generate-database-types.ts --check",
    "odoo:dry-run": "tsx scripts/odoo-dry-run.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.0.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "recharts": "^3.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "daisyui": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.5"
  }
