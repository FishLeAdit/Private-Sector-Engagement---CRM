# Copy to .env.local and replace these placeholders for sign-in.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server only: never prefix this variable with NEXT_PUBLIC_. Used by the administrative seeds and the
# Odoo dry run, and by the app server only for the superadmin's sign-in changes (creating and deleting
# accounts, setting passwords). Ordinary login and CRM requests never use it.
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Optional live browser tests. Use fictional demo accounts; keep values private.
# E2E_PSE_EMAIL=
# E2E_PSE_PASSWORD=
# E2E_RESTRICTED_EMAIL=
# E2E_RESTRICTED_PASSWORD=
# Optional signed-in specs in tests/e2e/live create, edit and delete "QA …" records on the configured project.
# Contributions, target saves/approval and configuration writes are blocked in the browser.
# E2E_LIVE_WRITES=1
# E2E_BASE_URL=http://127.0.0.1:3100

# Server-only: disable until a multi-instance deployment has a shared cache handler.
# PSE_REPORT_CACHE_ENABLED=true
