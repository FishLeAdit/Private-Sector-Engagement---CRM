# Copy to .env.local and replace these placeholders for sign-in.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional administrative demo seed only; ordinary login/CRM requests do not need it.
# Server only: never prefix this variable with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Optional live browser tests. Use fictional demo accounts; keep values private.
# E2E_PSE_EMAIL=
# E2E_PSE_PASSWORD=
# E2E_RESTRICTED_EMAIL=
# E2E_RESTRICTED_PASSWORD=
# Optional contact E2E creates/edits/deletes two fictional records.
# E2E_CONTACT_WRITES=1
# E2E_BASE_URL=http://127.0.0.1:3100

# Server-only: disable until a multi-instance deployment has a shared cache handler.
# PSE_REPORT_CACHE_ENABLED=true
